#: ../data/umenu.desktop.in.h:1
msgid "Clipboard Manager"
msgstr "Gerenciador de área de transferência"

#: ../data/umenu.desktop.in.h:2
msgid "GTK+ Clipboard Manager"
msgstr "Gerenciador de área de transferência em GTK+"

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:1
msgid "Use clipboard (Ctrl+C)"
msgstr "Usar área de transferênica (Ctrl+C)"

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:2
#: ../data/preferences.ui.h:3
msgid ""
"Adds content which is copied to the clipboard with e.g. Ctrl + C to the "
"clipboard history."
msgstr ""

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:3
msgid "Use primary selection"
msgstr "Usar seleção primária"

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:4
#: ../data/preferences.ui.h:5
msgid ""
"Adds the primary selection (an area of the screen which is selected with the "
"mouse) to the clipboard history. Enabling will start process which "
"continually checks what is selected. This might discharge your battery "
"quicker."
msgstr ""

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:5
msgid "Add images to clipboard history"
msgstr ""

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:6
#: ../data/preferences.ui.h:7
msgid ""
"Add images copied to clipboard to clipboard history (e.g. when you right "
"click on an image in your browser and choose copy image). Enabling this "
"option will increase memory consumption. Images already added to clipboard "
"history will remain even when disabled."
msgstr ""

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:7
msgid "Synchronize clipboards"
msgstr "Sincronizar áreas de transferênica"

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:8
#: ../data/preferences.ui.h:11
msgid ""
"Synchronizes the selection (an area of the screen which is selected with the "
"mouse) and the clipboard so that anything in the selection is immediately "
"available in the clipboard and vice versa e.g. for pasting with Ctrl + V and "
"the middle mouse button."
msgstr ""
"Sincroniza a seleção (uma área da tela que foi selecionada com o mouse) e a "
"área de transferência para que tudo na seleção seja imediatamente disponível "
"na memória e vice versa."

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:9
msgid "Keep clipboard content"
msgstr "Manter o conteúdo da área de transferência."

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:10
#: ../data/preferences.ui.h:9
msgid ""
"Prevents an empty clipboard. For instance when an application exits, the "
"clipboard would usually be emptied."
msgstr ""
"Impede uma área de transferência vazia. Por exemplo, quando um aplicativo é "
"encerrado, a área de transferência normalmente seria esvaziado."

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:11
msgid "Automatically paste selected item"
msgstr "Cola o item selecionado automaticamente"

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:12
#: ../data/preferences.ui.h:13
msgid ""
"Automatically paste selected item instead of just copying it to the "
"clipboard."
msgstr ""
"Automaticamente cola o item selecionado ao invés de copiar para a área de "
"transferência."

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:13
msgid "Number of recent clipboard items"
msgstr ""

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:14
msgid "Number of recent clipboard items shown in clipboard menu."
msgstr ""

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:15
msgid "Clipboard content filter pattern"
msgstr ""

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:16
msgid ""
"Regex filter pattern whereas all clipboard items matching this pattern will "
"be filtered and not added to clipboard history."
msgstr ""

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:17
msgid "Lookup dictionary for application using different paste keybindings"
msgstr ""

#: ../data/com.biryukwolf.umenu.gschema.xml.in.in.h:18
msgid ""
"A lookup dictionary for applications using different paste keybindings than "
"Ctrl + V. Pattern of each string in this array is path-of-app|keybinding"
msgstr ""

